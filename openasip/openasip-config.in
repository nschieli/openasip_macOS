#!/bin/sh

# Derive the prefix from THIS SCRIPT'S OWN LOCATION, falling back to the
# configured one.
#
# This script is the prefix oracle for the whole toolset: everything that needs
# to find share/openasip asks `tce-config --prefix` (a symlink to this file).
# With the configured prefix baked in, a tree that is moved, repackaged or
# unpacked anywhere other than where it was built reports a directory that does
# not exist on that machine -- and the failure surfaces far away, as
# "Could not find minimal_with_stdout.adf" or "No schema file set", with the
# real cause nowhere in the message.
#
# The override applies only when the layout actually looks like an install
# (<prefix>/bin/openasip-config with a share/openasip beside it), so an
# in-tree or unusual invocation still gets the configured value.
_oa_self=$0
while [ -L "$_oa_self" ]; do
  _oa_link=`readlink "$_oa_self"`
  case $_oa_link in
    /*) _oa_self=$_oa_link ;;
    *)  _oa_self=`dirname "$_oa_self"`/$_oa_link ;;
  esac
done
_oa_bindir=`cd "\`dirname "$_oa_self"\`" 2>/dev/null && pwd`

prefix=@prefix@
case $_oa_bindir in
  */bin)
    _oa_root=`dirname "$_oa_bindir"`
    if test -d "$_oa_root/share/openasip"; then
      prefix=$_oa_root
    fi
    ;;
esac
exec_prefix=@exec_prefix@
exec_prefix_set=no

tcl_ldflags="@TCL_LIBDIR@ @TCL_LD_FLAGS@"

editline_ldflags="@EDITLINE_LD_FLAGS@"
editline_includes="@EDITLINE_INCLUDES@"

boost_includes="@BOOST_INCLUDES@"
boost_ldflags="@BOOST_LIBDIR@ @BOOST_LDFLAGS@"

sqlite_includes="@SQLITE_INCLUDES@"
sqlite_ldflags="@SQLITE_LD_FLAGS@"

xerces_ldflags="@XERCES_LIBDIR@ @XERCES_LIBS@"

shared_cxxflags="@SHARED_CXX_FLAGS@"

dl_flags="@DL_FLAGS@"

cppflags="@CPPFLAGS@"

cxxflags="@CXXFLAGS@"

cxx_command="@CXX@"

dynamic_flag="@DYNAMIC_FLAG@"

version_string="@VERSION_STRING@"

llvm_ldflags="@LLVM_LDFLAGS@"

llvm_config="@LLVM_CONFIG@"

usage()
{
	cat <<EOF
Usage: openasip-config [OPTIONS]
Options:
  [--version]
  [--prefix]
  [--exec-prefix]
  [--libs]
  [--includes]
  [--cxxflags]
  [--c++-compiler]
  [--so-flags]
  [--llvm-config]
EOF
	exit $1
}

if test $# -eq 0; then
	usage 1 1>&2
fi

while test $# -gt 0; do
  case "$1" in
  -*=*) optarg=`echo "$1" | sed 's/[-_a-zA-Z0-9]*=//'` ;;
  *) optarg= ;;
  esac

  case $1 in
    --version)
      echo $version_string
      exit
      ;;
    --prefix)
      echo_prefix=yes
      ;;
    --exec-prefix)
      echo_exec_prefix=yes
      ;;
    --libs)
      echo_libs=yes
      ;;
    --includes)
      echo_includes=yes
      ;;
    --c++-compiler)
      compiler_command=yes
      ;;
    --so-flags)
      so_flags=yes
      ;;
    --cxxflags)
      echo_cxxflags=yes
      ;;
    --llvm-config)
      echo_llvm_config=yes
      ;;
    *)
      usage 1 1>&2
      ;;
  esac
  shift
done

if test "$echo_prefix" = "yes"; then
    echo $prefix
fi

if test "$compiler_command" = "yes"; then
    echo $cxx_command
fi

if test "$so_flags" = "yes"; then
    echo $shared_cxxflags
fi

if test "$echo_exec_prefix" = "yes"; then
    echo $exec_prefix
fi

if test "$echo_includes" = "yes"; then
    includes="-I@includedir@ -I@includedir@/tce"
    echo "$includes $editline_includes $boost_includes $sqlite_includes"
fi

if test "$echo_libs" = "yes"; then
    libdirs=-L@libdir@
    echo "$libdirs -lopenasip"
fi

if test "$echo_cxxflags" = "yes"; then
    echo "$cxxflags"
fi

if test "$echo_llvm_config" = "yes"; then
    echo "$llvm_config"
fi
